<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#f8fafc">
  <meta name="color-scheme" content="light">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <meta name="apple-mobile-web-app-title" content="Gmail Hub">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="description" content="Kelola banyak akun Gmail dari satu kotak masuk yang ringan, rapi, dan aman.">
  <meta name="referrer" content="no-referrer">
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="icon" href="/icon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <title>Unified Gmail Hub</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    :root {
      color-scheme: light;
      --canvas: #f8fafc;
      --surface: #ffffff;
      --surface-soft: #f1f5f9;
      --line: #e2e8f0;
      --ink: #0f172a;
      --muted: #475569;
      --faint: #64748b;
      --blue: #2563eb;
      --blue-soft: #eff6ff;
      --red: #dc2626;
      --green: #15803d;
      --sidebar-width: 260px;
      --list-width: 360px;
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      font-synthesis: none;
      text-rendering: optimizeLegibility;
      -webkit-font-smoothing: antialiased;
    }
    * { box-sizing: border-box; }
    html, body { width: 100%; min-height: 100%; margin: 0; background: var(--canvas); color: var(--ink); }
    body { overflow: hidden; }
    button, input, textarea, select { font: inherit; }
    button { -webkit-tap-highlight-color: transparent; }
    .app-shell { display: grid; grid-template-columns: var(--sidebar-width) var(--list-width) minmax(0, 1fr); height: 100dvh; min-height: 0; overflow: hidden; }
    .sidebar { min-width: 0; background: #fff; border-right: 1px solid var(--line); display: flex; flex-direction: column; min-height: 0; }
    .inbox-panel { min-width: 0; display: flex; flex-direction: column; background: #fff; border-right: 1px solid var(--line); min-height: 0; }
    .reader-panel { min-width: 0; display: flex; flex-direction: column; background: var(--canvas); min-height: 0; }
    .panel-scroll { overflow: auto; min-height: 0; overscroll-behavior: contain; scrollbar-width: thin; }
    .brand-mark { width: 38px; height: 38px; border-radius: 12px; display: grid; place-items: center; background: #eff6ff; color: #1d4ed8; }
    .nav-item { width: 100%; min-height: 44px; display: flex; align-items: center; gap: 11px; padding: 9px 12px; border-radius: 11px; color: var(--muted); text-align: left; transition: background .15s ease, color .15s ease; }
    .nav-item:hover { background: #f8fafc; color: var(--ink); }
    .nav-item.active { background: var(--blue-soft); color: #1d4ed8; font-weight: 650; }
    .nav-item .nav-count { margin-left: auto; color: var(--faint); font-size: 12px; font-variant-numeric: tabular-nums; }
    .account-row { display: flex; align-items: center; gap: 9px; width: 100%; min-height: 48px; padding: 7px 9px; border-radius: 11px; text-align: left; }
    .account-row:hover, .account-row.active { background: #f1f5f9; }
    .avatar { width: 34px; height: 34px; flex: 0 0 34px; display: grid; place-items: center; border-radius: 11px; background: #e2e8f0; color: #334155; font-size: 12px; font-weight: 750; }
    .avatar.blue { background: #dbeafe; color: #1d4ed8; }
    .avatar.green { background: #dcfce7; color: #166534; }
    .avatar.violet { background: #ede9fe; color: #5b21b6; }
    .avatar.amber { background: #fef3c7; color: #92400e; }
    .account-meta { min-width: 0; flex: 1; }
    .account-meta strong, .account-meta span { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .account-meta strong { font-size: 12px; font-weight: 650; color: var(--ink); }
    .account-meta span { margin-top: 2px; font-size: 11px; color: var(--faint); }
    .status-dot { width: 7px; height: 7px; border-radius: 50%; background: #16a34a; flex: 0 0 7px; }
    .status-dot.error { background: var(--red); }
    .toolbar-button { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 42px; padding: 0 13px; border: 1px solid var(--line); border-radius: 10px; background: #fff; color: #334155; font-size: 13px; font-weight: 650; transition: background .15s ease, border-color .15s ease; }
    .toolbar-button:hover { background: #f8fafc; border-color: #cbd5e1; }
    .toolbar-button.primary { background: var(--blue); border-color: var(--blue); color: #fff; }
    .toolbar-button.primary:hover { background: #1d4ed8; }
    .toolbar-button:disabled { opacity: .55; cursor: not-allowed; }
    .icon-button { width: 44px; height: 44px; border-radius: 10px; display: inline-grid; place-items: center; color: #475569; }
    .icon-button:hover { background: #f1f5f9; color: var(--ink); }
    .search-wrap { position: relative; }
    .search-wrap input { width: 100%; height: 44px; border: 1px solid var(--line); border-radius: 11px; padding: 0 40px 0 40px; background: #fff; color: var(--ink); outline: none; font-size: 13px; }
    .search-wrap input:focus { border-color: #93c5fd; box-shadow: 0 0 0 3px #dbeafe; }
    .search-wrap .search-icon { position: absolute; left: 13px; top: 13px; color: #94a3b8; pointer-events: none; }
    .search-wrap .clear-search { position: absolute; right: 5px; top: 3px; }
    .message-card { width: 100%; display: block; text-align: left; padding: 14px 15px; border-bottom: 1px solid #f1f5f9; border-left: 3px solid transparent; background: #fff; transition: background .12s ease; }
    .message-card:hover { background: #f8fafc; }
    .message-card.active { background: #eff6ff; border-left-color: var(--blue); }
    .message-card.unread .sender, .message-card.unread .subject { font-weight: 750; color: var(--ink); }
    .message-card .sender, .message-card .subject { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .message-card .sender { font-size: 13px; font-weight: 600; }
    .message-card .subject { margin-top: 7px; font-size: 13px; font-weight: 550; color: #334155; }
    .message-card .snippet { margin-top: 5px; font-size: 12px; line-height: 1.45; color: #64748b; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .message-card .message-meta { margin-top: 9px; display: flex; align-items: center; gap: 7px; min-width: 0; color: #64748b; font-size: 10px; }
    .message-card .message-meta .account-label { max-width: 130px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; border-radius: 5px; padding: 3px 6px; background: #f1f5f9; }
    .unread-indicator { width: 7px; height: 7px; border-radius: 50%; background: var(--blue); flex: 0 0 7px; }
    .reader-toolbar { min-height: 62px; display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 9px 20px; border-bottom: 1px solid var(--line); background: #fff; }
    .reader-content { overflow: auto; min-height: 0; flex: 1; padding: 26px clamp(18px, 3vw, 42px) 32px; }
    .reader-paper { max-width: 900px; margin: 0 auto; border: 1px solid var(--line); border-radius: 16px; background: #fff; overflow: hidden; }
    .email-frame { display: block; width: 100%; min-height: 260px; border: 0; background: #fff; }
    .reply-box { max-width: 900px; margin: 18px auto 0; border: 1px solid var(--line); border-radius: 15px; background: #fff; padding: 16px; }
    .reply-box textarea { display: block; width: 100%; min-height: 112px; resize: vertical; border: 0; outline: 0; padding: 9px 0; color: var(--ink); font-size: 14px; line-height: 1.6; }
    .reply-box textarea::placeholder { color: #94a3b8; }
    .skeleton { position: relative; overflow: hidden; background: #e2e8f0; border-radius: 7px; }
    .skeleton::after { content: ""; position: absolute; inset: 0; transform: translateX(-100%); background: linear-gradient(90deg, transparent, #f8fafc, transparent); animation: shimmer 1.4s infinite; }
    @keyframes shimmer { 100% { transform: translateX(100%); } }
    .spinner { width: 15px; height: 15px; border: 2px solid currentColor; border-right-color: transparent; border-radius: 50%; display: inline-block; animation: spin .7s linear infinite; }
    @keyframes spin { to { transform: rotate(360deg); } }
    .toast-region { position: fixed; right: 18px; bottom: max(18px, env(safe-area-inset-bottom)); z-index: 100; display: grid; gap: 9px; width: min(370px, calc(100vw - 36px)); pointer-events: none; }
    .toast { border: 1px solid var(--line); border-radius: 12px; background: #fff; box-shadow: 0 12px 35px rgba(15, 23, 42, .12); padding: 12px 14px; font-size: 13px; color: var(--ink); display: flex; align-items: flex-start; gap: 9px; animation: toast-in .18s ease-out; }
    .toast.success .toast-mark { color: var(--green); }
    .toast.error .toast-mark { color: var(--red); }
    @keyframes toast-in { from { transform: translateY(8px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
    dialog { width: min(470px, calc(100vw - 28px)); max-height: min(90dvh, 680px); border: 1px solid var(--line); border-radius: 18px; padding: 0; background: #fff; color: var(--ink); box-shadow: 0 24px 80px rgba(15, 23, 42, .22); }
    dialog::backdrop { background: rgba(15, 23, 42, .42); backdrop-filter: blur(2px); }
    .modal-head { padding: 21px 22px 15px; border-bottom: 1px solid var(--line); }
    .modal-body { padding: 19px 22px 22px; }
    .form-label { display: block; margin-bottom: 7px; font-size: 12px; font-weight: 700; color: #334155; }
    .form-control { width: 100%; min-height: 45px; border: 1px solid #cbd5e1; border-radius: 10px; padding: 0 12px; background: #fff; color: var(--ink); outline: none; font-size: 14px; }
    .form-control:focus { border-color: #93c5fd; box-shadow: 0 0 0 3px #dbeafe; }
    .field-hint { margin-top: 6px; font-size: 11px; line-height: 1.5; color: #64748b; }
    .empty-state { display: grid; justify-items: center; text-align: center; padding: 50px 24px; }
    .empty-icon { width: 54px; height: 54px; display: grid; place-items: center; border: 1px solid var(--line); border-radius: 17px; color: #64748b; background: #fff; }
    .mobile-only { display: none; }
    .mobile-list-head { display: none; }
    .desktop-only { display: initial; }
    .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
    @media (max-width: 1180px) {
      :root { --sidebar-width: 224px; --list-width: 330px; }
      .reader-content { padding: 20px 18px 28px; }
    }
    @media (max-width: 920px) {
      .app-shell { grid-template-columns: 220px minmax(0, 1fr); }
      .reader-panel { display: none; }
      body.message-open .sidebar, body.message-open .inbox-panel { display: none; }
      body.message-open .reader-panel { display: flex; grid-column: 1 / -1; }
      .mobile-only { display: inline-grid; }
    }
    @media (max-width: 640px) {
      body { overflow: hidden; }
      .app-shell { display: block; height: 100dvh; }
      .sidebar { display: none; }
      .inbox-panel { height: 100%; border: 0; }
      .inbox-header { padding-top: max(13px, env(safe-area-inset-top)); }
      .reader-panel { display: none; height: 100%; }
      body.message-open .reader-panel { display: flex; }
      body.message-open .inbox-panel { display: none; }
      .reader-toolbar { padding: 7px 12px; min-height: 58px; }
      .reader-content { padding: 13px 10px 22px; }
      .reader-paper { border-radius: 12px; }
      .reply-box { padding: 12px; margin-top: 12px; }
      .message-card { padding: 14px 13px; }
      .mobile-list-head { display: flex; }
      .desktop-only { display: none !important; }
    }
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; scroll-behavior: auto !important; transition-duration: .01ms !important; }
    }
  </style>
</head>
<body>
  <div class="app-shell" id="appShell">
    <aside class="sidebar" aria-label="Navigasi utama">
      <div class="px-5 pt-5 pb-4 flex items-center gap-3">
        <div class="brand-mark" aria-hidden="true">
          <svg width="23" height="23" viewBox="0 0 24 24" fill="none"><path d="M3 7.5 12 14l9-6.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><rect x="3" y="5" width="18" height="14" rx="3" stroke="currentColor" stroke-width="2"/></svg>
        </div>
        <div class="min-w-0"><div class="text-sm font-bold tracking-tight">Unified Gmail Hub</div><div class="text-[11px] text-slate-500 mt-0.5">Satu pintu untuk semua inbox</div></div>
      </div>
      <div class="px-3 pb-3">
        <button class="toolbar-button primary w-full" id="addAccountButton" type="button">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          Tambah Akun Gmail
        </button>
      </div>
      <div class="px-3 pb-3">
        <button class="nav-item active" id="allInboxButton" type="button" data-filter="all">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M4 5h16v14H4z" stroke="currentColor" stroke-width="1.7"/><path d="m4 7 8 6 8-6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span class="text-[13px]">Semua Inbox</span><span class="nav-count" id="allUnreadCount">0</span>
        </button>
      </div>
      <div class="px-3 pb-2">
        <div class="px-3 mb-2 flex items-center justify-between"><span class="text-[10px] font-bold uppercase tracking-[.12em] text-slate-400">Kategori</span></div>
        <nav id="categoryNav" class="grid gap-1"></nav>
      </div>
      <div class="mt-3 px-3 flex items-center justify-between"><span class="px-3 text-[10px] font-bold uppercase tracking-[.12em] text-slate-400">Akun terhubung</span><span class="text-[10px] text-slate-400" id="accountCount">0 akun</span></div>
      <div class="panel-scroll flex-1 px-3 pt-2 pb-3" id="accountNav"></div>
      <div class="border-t border-slate-100 p-4"><div class="flex items-center justify-between gap-3"><span class="text-[11px] text-slate-500" id="connectionStatus">Menghubungkan…</span><span class="status-dot" id="connectionDot"></span></div><div class="mt-2 text-[10px] text-slate-400">Cache email disimpan lokal di D1</div></div>
    </aside>
