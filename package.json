{
  "name": "unified-gmail-hub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Single-origin multi-account Gmail inbox on Cloudflare Workers and D1.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:apply": "wrangler d1 execute unified-gmail-hub --remote --file=./schema.sql",
    "db:local": "wrangler d1 execute unified-gmail-hub --local --file=./schema.sql",
    "test": "node --test",
    "build:inline-assets": "node tools/build-inline-assets.mjs",
    "check:inline-assets": "node tools/build-inline-assets.mjs --check"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
